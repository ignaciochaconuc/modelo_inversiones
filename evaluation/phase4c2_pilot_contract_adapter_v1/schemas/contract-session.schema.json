{
  "$defs": {
    "ContractInterval": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "active",
            "pause"
          ],
          "title": "Kind",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "material_reading",
                "contract_mapping",
                "evidence_check",
                "owner_review",
                "administration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        },
        "pause_reason": {
          "anyOf": [
            {
              "enum": [
                "break",
                "interruption",
                "ai_wait",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pause Reason"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "phase",
        "pause_reason",
        "started_at",
        "completed_at"
      ],
      "title": "ContractInterval",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "news-pilot-contract-session-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "packet_fingerprint": {
      "title": "Packet Fingerprint",
      "type": "string"
    },
    "disposition_id": {
      "title": "Disposition Id",
      "type": "string"
    },
    "factual_sha256": {
      "title": "Factual Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "unfilled",
        "in_progress",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "opening_authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review Id"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Id"
    },
    "reviewer_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Name"
    },
    "execution_mode": {
      "anyOf": [
        {
          "enum": [
            "manual_chatgpt_owner",
            "manual_human"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Mode"
    },
    "independence_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Independence Context"
    },
    "independent_human_review": {
      "const": false,
      "title": "Independent Human Review",
      "type": "boolean"
    },
    "adjudication_claimed": {
      "const": false,
      "title": "Adjudication Claimed",
      "type": "boolean"
    },
    "visible_model_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visible Model Label"
    },
    "model_snapshot": {
      "title": "Model Snapshot",
      "type": "null"
    },
    "api_parameters": {
      "title": "Api Parameters",
      "type": "null"
    },
    "api_tokens": {
      "title": "Api Tokens",
      "type": "null"
    },
    "timestamp_source": {
      "anyOf": [
        {
          "enum": [
            "owner_declared",
            "manual_clock",
            "platform_export",
            "mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Timestamp Source"
    },
    "timestamp_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Timestamp Basis"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "active_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Seconds"
    },
    "pause_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pause Seconds"
    },
    "phase_seconds": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "material_reading",
          "contract_mapping",
          "evidence_check",
          "owner_review",
          "administration"
        ]
      },
      "title": "Phase Seconds",
      "type": "object"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/ContractInterval"
      },
      "title": "Intervals",
      "type": "array"
    },
    "factual_timing_reused": {
      "const": false,
      "title": "Factual Timing Reused",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "packet_fingerprint",
    "disposition_id",
    "factual_sha256",
    "status",
    "opening_authorization",
    "review_id",
    "reviewer_id",
    "reviewer_name",
    "execution_mode",
    "independence_context",
    "independent_human_review",
    "adjudication_claimed",
    "visible_model_label",
    "model_snapshot",
    "api_parameters",
    "api_tokens",
    "timestamp_source",
    "timestamp_basis",
    "started_at",
    "completed_at",
    "active_seconds",
    "pause_seconds",
    "phase_seconds",
    "intervals",
    "factual_timing_reused"
  ],
  "title": "ContractSession",
  "type": "object"
}
