    "authorized_by": {
      "minLength": 1,
      "title": "Authorized By",
      "type": "string"
    },
    "decision_source": {
      "minLength": 1,
      "title": "Decision Source",
      "type": "string"
    },
    "owner_statement": {
      "minLength": 1,
      "title": "Owner Statement",
      "type": "string"
    },
    "source_message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
