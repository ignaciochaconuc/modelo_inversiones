{
  "$defs": {
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "active",
            "pause"
          ],
          "title": "Kind",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "reading",
                "factual_annotation",
                "citation_check",
                "contract_review",
                "discrepancies",
                "adjudication",
                "administration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        },
        "pause_reason": {
          "anyOf": [
            {
              "enum": [
                "break",
                "interruption",
                "queue",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pause Reason"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "phase",
        "pause_reason",
        "started_at",
        "completed_at"
      ],
      "title": "Interval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "news-pilot-timing-provenance-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "packet_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Packet Fingerprint",
      "type": "string"
    },
    "status": {
      "enum": [
        "unfilled",
        "in_progress",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "review_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review Id"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Id"
    },
    "reviewer_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewer Name"
    },
    "review_kind": {
      "anyOf": [
        {
          "enum": [
            "human_owner",
            "human_reviewer",
            "ai_assisted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review Kind"
    },
    "independence": {
      "anyOf": [
        {
          "enum": [
            "not_claimed",
            "not_independent",
            "reviewer_declared_independent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Independence"
    },
    "independence_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Independence Basis"
    },
    "execution_mode": {
      "anyOf": [
        {
          "const": "manual_no_api",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Mode"
    },
    "model_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Label"
    },
    "model_snapshot": {
      "title": "Model Snapshot",
      "type": "null"
    },
    "api_parameters": {
      "title": "Api Parameters",
      "type": "null"
    },
    "api_tokens": {
      "title": "Api Tokens",
      "type": "null"
    },
    "timestamp_source": {
      "anyOf": [
        {
          "enum": [
            "owner_declared",
            "manual_clock",
            "platform_export",
            "mixed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Timestamp Source"
    },
    "timestamp_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Timestamp Basis"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "factual_closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Factual Closed At"
    },
    "active_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Seconds"
    },
    "pause_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pause Seconds"
    },
    "phase_seconds": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "reading",
          "factual_annotation",
          "citation_check",
          "contract_review",
          "discrepancies",
          "adjudication",
          "administration"
        ]
      },
      "title": "Phase Seconds",
      "type": "object"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/Interval"
      },
      "title": "Intervals",
      "type": "array"
    },
    "discrepancy_status": {
      "anyOf": [
        {
          "enum": [
            "no_disagreement",
            "disagreement",
            "unresolved",
            "not_applicable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Discrepancy Status"
    },
    "adjudication_status": {
      "anyOf": [
        {
          "enum": [
            "not_performed",
            "performed",
            "deferred"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Adjudication Status"
    },
    "adjudicates_review_ids": {
      "items": {
        "type": "string"
      },
      "title": "Adjudicates Review Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "packet_fingerprint",
    "status",
    "review_id",
    "reviewer_id",
    "reviewer_name",
    "review_kind",
    "independence",
    "independence_basis",
    "execution_mode",
    "model_label",
    "model_snapshot",
    "api_parameters",
    "api_tokens",
    "timestamp_source",
    "timestamp_basis",
    "started_at",
    "completed_at",
    "factual_closed_at",
    "active_seconds",
    "pause_seconds",
    "phase_seconds",
    "intervals",
    "discrepancy_status",
    "adjudication_status",
    "adjudicates_review_ids"
  ],
  "title": "Timing",
  "type": "object"
}
